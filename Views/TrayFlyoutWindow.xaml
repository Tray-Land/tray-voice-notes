<?xml version="1.0" encoding="utf-8"?>
<ex:WindowEx
    x:Class="TrayVoiceNotes.Views.TrayFlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ex="using:WinUIEx"
    Title="Tray Voice Notes">

    <Grid x:Name="PopupRoot" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="Escape_Invoked" />
            <KeyboardAccelerator Key="Left" Invoked="Escape_Invoked" Modifiers="Menu" />
        </Grid.KeyboardAccelerators>
        <ContentPresenter x:Name="PageHost" PointerPressed="PageHost_PointerPressed">
            <ContentPresenter.ContentTransitions>
                <TransitionCollection>
                    <ContentThemeTransition HorizontalOffset="24" />
                </TransitionCollection>
            </ContentPresenter.ContentTransitions>
        </ContentPresenter>
    </Grid>
</ex:WindowEx>
