<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TrayVoiceNotes.Views.FlyoutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TrayVoiceNotes.Controls"
    xmlns:models="using:TrayVoiceNotes.Models"
    Background="Transparent">

    <Grid Padding="16,12,12,12" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Voice notes" />
            <Button
                x:Name="RecordButton"
                Grid.Column="1"
                AutomationProperties.Name="Start recording"
                Click="RecordButton_Click"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Start recording">
                <FontIcon FontSize="14" Glyph="&#xE720;" />
            </Button>
            <Button
                Grid.Column="2"
                AutomationProperties.Name="Settings"
                Click="SettingsButton_Click"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Settings">
                <FontIcon FontSize="14" Glyph="&#xE713;" />
            </Button>
            <Button
                Grid.Column="3"
                AutomationProperties.Name="Quit"
                Click="QuitButton_Click"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Quit Voice Notes">
                <FontIcon FontSize="14" Glyph="&#xE7E8;" />
            </Button>
        </Grid>

        <!--  Live recording  -->
        <Grid
            x:Name="RecordingPanel"
            Grid.Row="1"
            Padding="12,10"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
            BorderThickness="1"
            ColumnSpacing="10"
            CornerRadius="8"
            Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Ellipse
                x:Name="RecordingDot"
                Width="10"
                Height="10"
                VerticalAlignment="Center"
                Fill="{ThemeResource SystemFillColorCriticalBrush}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        x:Name="RecordingStateText"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Recording" />
                    <TextBlock
                        x:Name="ElapsedText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="0:00" />
                </StackPanel>
                <ProgressBar
                    x:Name="LevelMeter"
                    AutomationProperties.Name="Input level"
                    Maximum="1"
                    Value="0" />
            </StackPanel>
            <Button
                x:Name="PauseButton"
                Grid.Column="2"
                AutomationProperties.Name="Pause recording"
                Click="PauseButton_Click"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Pause recording">
                <FontIcon x:Name="PauseGlyph" FontSize="14" Glyph="&#xE769;" />
            </Button>
            <Button
                Grid.Column="3"
                AutomationProperties.Name="Stop and save"
                Click="StopButton_Click"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Stop and save">
                <FontIcon FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Glyph="&#xE71A;" />
            </Button>
            <Button
                Grid.Column="4"
                AutomationProperties.Name="Discard recording"
                Click="DiscardButton_Click"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Discard recording">
                <FontIcon FontSize="14" Glyph="&#xE74D;" />
            </Button>
        </Grid>

        <InfoBar
            x:Name="StatusBar"
            Grid.Row="2"
            IsClosable="True"
            IsOpen="False"
            Severity="Warning">
            <InfoBar.ActionButton>
                <Button x:Name="RetryButton" Click="RetryButton_Click" Content="Try again" Visibility="Collapsed" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!--  Transcript search  -->
        <AutoSuggestBox
            x:Name="SearchBox"
            Grid.Row="3"
            AutomationProperties.Name="Search transcripts"
            PlaceholderText="Search transcripts"
            QueryIcon="Find"
            TextChanged="SearchBox_TextChanged" />

        <!--  Recordings  -->
        <ListView
            x:Name="NotesList"
            Grid.Row="4"
            Margin="-4,0,-4,0"
            IsItemClickEnabled="True"
            ItemClick="NotesList_ItemClick"
            SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                    <Setter Property="Padding" Value="4,0" />
                    <Setter Property="Margin" Value="0,0,0,6" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:VoiceNote">
                    <SwipeControl Tag="{x:Bind}">
                    <SwipeControl.RightItems>
                        <SwipeItems Mode="Reveal">
                            <SwipeItem
                                Background="{ThemeResource SystemFillColorAttentionBrush}"
                                Invoked="ExportSwipeItem_Invoked"
                                Text="Export">
                                <SwipeItem.IconSource>
                                    <FontIconSource Glyph="&#xE74E;" />
                                </SwipeItem.IconSource>
                            </SwipeItem>
                            <SwipeItem
                                Background="{ThemeResource SystemFillColorCriticalBrush}"
                                Invoked="DeleteSwipeItem_Invoked"
                                Text="Delete">
                                <SwipeItem.IconSource>
                                    <FontIconSource Glyph="&#xE74D;" />
                                </SwipeItem.IconSource>
                            </SwipeItem>
                        </SwipeItems>
                    </SwipeControl.RightItems>
                    <Grid
                        Padding="8,8,12,10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        ColumnSpacing="8"
                        CornerRadius="8"
                        RowSpacing="6">
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem
                                    Click="ExportAudioMenuItem_Click"
                                    Tag="{x:Bind}"
                                    Text="Save audio…">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8D6;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    Click="ExportZipMenuItem_Click"
                                    Tag="{x:Bind}"
                                    Text="Save audio, transcript and notes (.zip)…">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xF012;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem
                                    Click="DeleteNoteMenuItem_Click"
                                    Tag="{x:Bind}"
                                    Text="Delete">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE74D;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Button
                            Width="36"
                            Height="36"
                            Padding="0"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{x:Bind PlayLabel, Mode=OneWay}"
                            Click="PlayButton_Click"
                            CornerRadius="18"
                            Tag="{x:Bind}"
                            ToolTipService.ToolTip="{x:Bind PlayLabel, Mode=OneWay}">
                            <FontIcon FontSize="14" Glyph="{x:Bind PlayGlyph, Mode=OneWay}" />
                        </Button>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                MaxLines="1"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind Title, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind Subtitle, Mode=OneWay}" />
                        </StackPanel>
                        <FontIcon
                            Grid.Column="2"
                            VerticalAlignment="Top"
                            AutomationProperties.Name="Has notes"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE70B;"
                            ToolTipService.ToolTip="Has notes"
                            Visibility="{x:Bind HasNotes, Mode=OneWay}" />

                        <controls:WaveformView
                            Grid.Row="1"
                            Grid.ColumnSpan="3"
                            Height="28"
                            BarBrush="{ThemeResource ControlStrongFillColorDisabledBrush}"
                            IsSeekEnabled="True"
                            Peaks="{x:Bind Peaks, Mode=OneWay}"
                            PlayedBrush="{ThemeResource AccentFillColorDefaultBrush}"
                            Progress="{x:Bind PlaybackProgress, Mode=OneWay}"
                            SeekRequested="Waveform_SeekRequested"
                            Tag="{x:Bind}" />

                        <TextBlock
                            Grid.Row="2"
                            Grid.ColumnSpan="3"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            MaxLines="2"
                            controls:SearchHighlight.Query="{x:Bind SearchQuery, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind Preview, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind HasPreview, Mode=OneWay}" />
                        <StackPanel
                            Grid.Row="2"
                            Grid.ColumnSpan="3"
                            Orientation="Horizontal"
                            Spacing="6"
                            Visibility="{x:Bind HasStatus, Mode=OneWay}">
                            <ProgressRing
                                Width="12"
                                Height="12"
                                IsActive="{x:Bind IsBusy, Mode=OneWay}"
                                Visibility="{x:Bind IsBusy, Mode=OneWay}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind StatusText, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    </SwipeControl>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!--  Empty state  -->
        <StackPanel
            x:Name="EmptyPanel"
            Grid.Row="4"
            MaxWidth="280"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="Collapsed">
            <FontIcon
                FontSize="32"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="&#xE720;" />
            <TextBlock
                x:Name="EmptyTitle"
                HorizontalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="No recordings yet" />
            <TextBlock
                x:Name="EmptyHint"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>

        <!--  Footer: transcription / model download status  -->
        <Grid x:Name="Footer" Grid.Row="5" ColumnSpacing="8" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="FooterText"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />
            <ProgressRing
                x:Name="FooterRing"
                Grid.Column="1"
                Width="16"
                Height="16"
                IsActive="False" />
        </Grid>
    </Grid>
</Page>
