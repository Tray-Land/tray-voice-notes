<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TrayVoiceNotes.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="StackPanel">
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Spacing" Value="8" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="CaptionStyle" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <Grid Padding="8,12,12,12" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="4">
            <Button
                x:Name="BackButton"
                AutomationProperties.Name="Back"
                Click="BackButton_Click"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Back">
                <FontIcon FontSize="14" Glyph="&#xE72B;" />
            </Button>
            <TextBlock
                Margin="4,0,0,0"
                VerticalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Settings" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="8,0,-12,0" Padding="0,0,12,0">
            <StackPanel Spacing="6">
                <TextBlock Margin="0,0,0,2" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Recording" />

                <StackPanel Style="{StaticResource CardStyle}">
                    <TextBlock Text="Right-click the tray icon to" />
                    <ComboBox
                        x:Name="RightClickCombo"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Right-click the tray icon to"
                        SelectionChanged="RightClickCombo_SelectionChanged">
                        <ComboBoxItem Content="Start recording" />
                        <ComboBoxItem Content="Show the menu" />
                    </ComboBox>
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="Shift+right-click always shows the menu." />
                </StackPanel>

                <StackPanel x:Name="WhileRecordingCard" Style="{StaticResource CardStyle}">
                    <TextBlock Text="Right-click while recording to" />
                    <ComboBox
                        x:Name="WhileRecordingCombo"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Right-click while recording to"
                        SelectionChanged="WhileRecordingCombo_SelectionChanged">
                        <ComboBoxItem Content="Stop and transcribe" />
                        <ComboBoxItem Content="Pause and resume" />
                    </ComboBox>
                    <TextBlock
                        x:Name="WhileRecordingCaption"
                        Style="{StaticResource CaptionStyle}"
                        Text="With pause, stop from the flyout when you're done." />
                </StackPanel>

                <StackPanel Style="{StaticResource CardStyle}">
                    <TextBlock Text="Microphone" />
                    <ComboBox
                        x:Name="MicrophoneCombo"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Microphone"
                        SelectionChanged="MicrophoneCombo_SelectionChanged" />
                </StackPanel>

                <TextBlock Margin="0,12,0,2" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Transcription" />

                <StackPanel Style="{StaticResource CardStyle}">
                    <TextBlock Text="Whisper model" />
                    <ComboBox
                        x:Name="ModelCombo"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Whisper model"
                        SelectionChanged="ModelCombo_SelectionChanged" />
                    <TextBlock x:Name="ModelCaption" Style="{StaticResource CaptionStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="DownloadButton" Click="DownloadButton_Click" Content="Download now" />
                        <Button x:Name="DeleteModelButton" Click="DeleteModelButton_Click" Content="Remove" />
                        <ProgressRing
                            x:Name="DownloadRing"
                            Width="16"
                            Height="16"
                            IsActive="False"
                            IsIndeterminate="False"
                            Maximum="100" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Margin="0,12,0,2" Style="{StaticResource BodyStrongTextBlockStyle}" Text="General" />

                <Grid
                    Padding="14,10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    ColumnSpacing="12"
                    CornerRadius="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Start with Windows" />
                        <TextBlock
                            x:Name="StartupDescription"
                            Style="{StaticResource CaptionStyle}"
                            Text="Keep the tray icon ready after you sign in." />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="StartupToggle"
                        Grid.Column="1"
                        MinWidth="0"
                        AutomationProperties.Name="Start with Windows"
                        IsEnabled="False"
                        OffContent=""
                        OnContent=""
                        Toggled="StartupToggle_Toggled" />
                </Grid>

                <StackPanel Margin="0,8,0,0" Orientation="Horizontal" Spacing="8">
                    <Button Click="OpenFolderButton_Click" Content="Open recordings folder" />
                    <Button Click="QuitButton_Click" Content="Quit" />
                </StackPanel>

                <TextBlock
                    x:Name="VersionText"
                    Margin="0,8,0,0"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
